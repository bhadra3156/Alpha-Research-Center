@tailwind base;
@tailwind components;
@tailwind utilities;

@layer components {
  .card {
    @apply bg-[#18181b] border border-[#27272a] rounded-xl shadow-sm;
  }
  .badge-pass {
    @apply bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 text-[10px] font-semibold px-2 py-0.5 rounded-md;
  }
  .badge-stage {
    @apply bg-blue-500/10 text-blue-400 border border-blue-500/20 text-[10px] font-semibold px-2 py-0.5 rounded-md;
  }
  .badge-smart {
    @apply bg-amber-500/10 text-amber-400 border border-amber-500/20 text-[10px] font-semibold px-2 py-0.5 rounded-md;
  }
  .badge-fail {
    @apply bg-red-500/10 text-red-400 border border-red-500/20 text-[10px] font-semibold px-2 py-0.5 rounded-md;
  }
  .metric-number {
    @apply text-2xl font-bold tracking-tight text-[#fafafa] font-mono tabular-nums;
  }
  .metric-label {
    @apply text-[10px] font-semibold text-[#71717a] uppercase tracking-widest;
  }
}
